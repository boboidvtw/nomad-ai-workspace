{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Nomad AI Workspace",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nomad-ai-workspace@nomad",
      "strict_min_version": "115.0"
    }
  },
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "scripting",
    "alarms",
    "activeTab"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "oauth2": {
    "client_id": "462948120910-vvunu0k3b4vi37u23mqnh77mbgdjcg78.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://business.gemini.google/*",
    "https://aistudio.google.com/*",
    "https://aistudio.google.cn/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://lh3.google.com/*",
    "https://*.ggpht.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  },
  "background": {
    "service_worker": "src/pages/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*",
        "https://aistudio.google.com/*",
        "https://aistudio.google.cn/*"
      ],
      "js": [
        "src/pages/content/index.tsx"
      ],
      "css": [
        "contentStyle.css"
      ]
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*"
      ],
      "js": [
        "src/pages/content/usageObserverLoader.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/pages/content/claude/index.tsx"
      ],
      "css": [
        "contentStyle.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "contentStyle.css",
        "changelog-activity-view.png",
        "watermark-native-steps.png",
        "icon-128.png",
        "icon-32.png",
        "mascot-logo.png",
        "katex-config.js",
        "fetchInterceptor.js",
        "claude-usage-observer.js",
        "response-complete-observer.js",
        "usage-observer.js",
        "conversation-history-observer.js",
        "prevent-auto-scroll.js",
        "assets/*.js",
        "assets/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}