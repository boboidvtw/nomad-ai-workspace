{
  "name": "nomad-ai-studio",
  "version": "1.4.0",
  "description": "Nomad AI Studio - All-in-One Multi-AI Super Station",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test src/__tests__/*.test.js"
  },
  "devDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3"
  },
  "productName": "Nomad AI Studio",
  "author": "bobo li <boboidvtw@gmail.com>",
  "build": {
    "appId": "com.nomad.aistudio",
    "productName": "Nomad AI Studio",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "nomad.icns",
      "nomad.ico",
      "nomad.png",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "src/**/*",
      "node_modules/@nomad/**/*"
    ],
    "extraResources": [
      {
        "from": "../../dist_chrome",
        "to": "dist_chrome",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "nomad.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "nomad.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nomad AI Studio"
    },
    "linux": {
      "icon": "nomad.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@nomad/core": "*",
    "@nomad/dashboard": "*"
  }
}
