{
  "name": "nomad-ai-workspace",
  "version": "1.4.0",
  "description": "Unified local-first workspace for Gemini, Claude, ChatGPT, and Grok with hierarchical multi-AI sidebar and segregated Google Drive sync.",
  "packageManager": "npm@11.19.1",
  "license": "GPL-3.0",
  "author": "bobo li",
  "repository": {
    "type": "git",
    "url": "https://github.com/boboidvtw/nomad-ai-workspace.git"
  },
  "scripts": {
    "bump": "node scripts/bump-version.js",
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:edge": "node scripts/build-edge.js",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "build:safari": "vite build --config vite.config.safari.ts && node scripts/verify-safari-resources.mjs",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "build:browsers": "npm run build:all && npm run build:edge",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:chrome-open": "node scripts/launch-chrome.cjs",
    "dev:firefox": "nodemon --config nodemon.firefox.json",
    "dev:safari": "nodemon --config nodemon.safari.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean:build": "find .build -mindepth 1 -maxdepth 1 ! -name sparkle-source-packages -exec rm -rf {} + && echo 'Cleared Xcode derived data (kept .build/sparkle-source-packages).'",
    "i18n:check": "node scripts/check-locale-keys.mjs",
    "regressions:check": "node scripts/validate-regression-notes.mjs",
    "filesize:check": "node scripts/check-file-size.mjs",
    "filesize:update": "node scripts/check-file-size.mjs --update",
    "typecheck": "tsc --noEmit",
    "verify:pr": "npm run format:check && npm run lint:check && npm run typecheck && npm run i18n:check && npm run regressions:check && npm run filesize:check && npm run plugin:check && npm run test && npm run build:all && npm run docs:build",
    "verify:katex-export": "bun scripts/verify-katex-export.ts",
    "verify:safari-resources": "node scripts/verify-safari-resources.mjs",
    "commitlint": "commitlint --edit $GIT_PARAMS",
    "catalog:build": "tsx scripts/build-plugin-catalog.ts",
    "plugin:new": "tsx scripts/plugin-new.ts",
    "plugin:check": "tsx scripts/plugin-check.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sponsors:update": "node scripts/generate-sponsors.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "prepare": "node scripts/install-git-hooks.cjs",
    "desktop": "cd packages/desktop && ./node_modules/.bin/electron .",
    "desktop:dev": "cd packages/desktop && ./node_modules/.bin/electron . --enable-logging",
    "daemon": "node packages/daemon/bin/nomad-daemon.js run",
    "daemon:start": "node packages/daemon/bin/nomad-daemon.js start",
    "daemon:stop": "node packages/daemon/bin/nomad-daemon.js stop",
    "daemon:restart": "node packages/daemon/bin/nomad-daemon.js restart",
    "daemon:status": "node packages/daemon/bin/nomad-daemon.js status",
    "probe": "node packages/daemon/bin/nomad-daemon.js probe",
    "dashboard": "node packages/daemon/bin/nomad-daemon.js run",
    "test:monorepo": "node --test packages/core/src/__tests__/*.test.js && node --test packages/daemon/src/__tests__/*.test.js && npm --prefix packages/desktop run test",
    "build:all-packages": "npm run build && npm --prefix packages/desktop run pack",
    "daemon:install": "node packages/daemon/scripts/install-launchagent.js",
    "daemon:uninstall": "node packages/daemon/scripts/uninstall-launchagent.js"
  },
  "type": "module",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3",
    "echarts": "6.1.0",
    "html-to-image": "^1.11.13",
    "json5": "^2.2.3",
    "katex": "^0.16",
    "lucide-react": "^0.553.0",
    "marked": "16.4.1",
    "marked-katex-extension": "^4",
    "mermaid": "11.12.2",
    "mermaid-legacy": "npm:mermaid@9.2.2",
    "onml": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "temml": "^0.13.1",
    "wavedrom": "3.6.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.1",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@tailwindcss/vite": "^4.1.15",
    "@types/chrome": "^0.1.24",
    "@types/jsdom": "^27.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "chrome-webstore-upload-cli": "3.5.0",
    "esbuild": "0.25.11",
    "fs-extra": "^11.3.0",
    "jsdom": "^27.1.0",
    "jszip": "^3.10.1",
    "nodemon": "^3.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.1.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.6",
    "vue": "^3.5.24",
    "vue3-marquee": "^4.2.2",
    "web-ext": "10.5.0",
    "web-ext-run": "^0.2.4"
  },
  "overrides": {
    "rollup": "^4.24.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
